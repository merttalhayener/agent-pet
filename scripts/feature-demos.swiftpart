    func exportFeatureDemos() {
        animation?.invalidate(); polling?.invalidate()
        language = .english; grouped = false; panelOnly = false; panelHidden = false; presentationHidden = false; collapsed = false
        dashboardScale = 1; textSize = 11.5; petScale = 1; listOpacity = 0.97
        view.hovered = false; pinned = []; foldedWorkspaces = []; expandedThreads = []; celebrationUntil = 0
        let now = Date().timeIntervalSince1970 * 1000
        let web = WorkspaceInfo(id: "website", name: "Website"), mobile = WorkspaceInfo(id: "mobile", name: "Mobile App")
        let folder = directory.appendingPathComponent("output")
        try! FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true)
        func run(_ label: String, _ done: Bool, _ tokens: Double, _ minutes: Double, _ model: String = "claude-opus-5-5") -> AgentRun {
            AgentRun(label: label, done: done ? true : nil, model: model, tokens: tokens, startedAt: now - minutes * 60000, lastAt: done ? now - minutes * 20000 : now)
        }
        var checkout = ThreadActivity(id: "claude:44444444-4444-4444-8444-444444444444", title: "Ship the checkout redesign", status: "running", changedAt: now, lastEventAt: now, startedAt: now - 540000, workspace: web)
        checkout.agents = [RunningAgent(kind: "workflow", label: "checkout-redesign", completed: 5, total: 7, phases: [
            WorkflowPhase(name: "Plan", completed: 1, total: 1, agents: [run("plan", true, 152000, 6)]),
            WorkflowPhase(name: "Build", completed: 3, total: 3, agents: [run("build:api", true, 201000, 9), run("build:ui", true, 265000, 11), run("build:tests", true, 145000, 7)]),
            WorkflowPhase(name: "Review", completed: 1, total: 3, agents: [run("review:code", true, 215000, 5), run("review:a11y", false, 96000, 3), run("review:perf", false, 74000, 2)])
        ])]
        var audit = ThreadActivity(id: "claude:55555555-5555-4555-8555-555555555555", title: "Audit API endpoints", status: "running", changedAt: now, lastEventAt: now, startedAt: now - 300000, workspace: web)
        audit.agents = [run("Check auth routes", true, 88000, 4, "claude-sonnet-5"), run("Check billing routes", true, 91000, 4, "claude-sonnet-5"), run("Check admin routes", false, 40000, 3, "claude-haiku-4-5"), run("Check public routes", false, 36000, 3, "claude-haiku-4-5")]
            .map { RunningAgent(kind: "agent", label: $0.label, done: $0.done, model: $0.model, tokens: $0.tokens, startedAt: $0.startedAt, lastAt: $0.lastAt) }
        for kind in ["status", "workspaces", "panel-only", "pets", "agents"] {
            let output = folder.appendingPathComponent(kind + ".gif")
            let gif = CGImageDestinationCreateWithURL(output as CFURL, "com.compuserve.gif" as CFString, 36, nil)!
            CGImageDestinationSetProperties(gif, [kCGImagePropertyGIFDictionary: [kCGImagePropertyGIFLoopCount: 0]] as CFDictionary)
            for frame in 0..<36 {
                let phase = frame / 12
                selected = kind == "pets" ? OriginalPets.catalog[phase].0 : kind == "workspaces" ? "fern" : "miso"
                tick = frame * 2
                grouped = kind == "agents" || (kind == "workspaces" && phase > 0)
                panelOnly = kind == "panel-only" && phase == 1
                foldedWorkspaces = kind == "workspaces" && phase == 2 ? [mobile.id] : []
                let state = kind == "status" ? ["running", "waiting", "ready"][phase] : "running"
                var first = ThreadActivity(id: "claude:11111111-1111-4111-8111-111111111111", title: "Build the landing page", status: state, changedAt: now, lastEventAt: now, startedAt: now - 120000, finishedAt: state == "ready" ? now - 60000 : nil, workspace: web)
                first.step = ThreadStep(tool: "Edit", target: "Hero.tsx"); first.question = PendingQuestion(header: "Hero layout")
                let second = ThreadActivity(id: "22222222-2222-4222-8222-222222222222", title: "Review accessibility", status: "ready", changedAt: now, lastEventAt: now, startedAt: now - 240000, finishedAt: now - 180000, workspace: web)
                var third = ThreadActivity(id: "claude:33333333-3333-4333-8333-333333333333", title: "Add sign in", status: "waiting", changedAt: now, lastEventAt: now, startedAt: now - 180000, workspace: mobile)
                third.question = PendingQuestion(header: "Sign-in method")
                var tests = ThreadActivity(id: "claude:66666666-6666-4666-8666-666666666666", title: "Fix flaky tests", status: "running", changedAt: now, lastEventAt: now, startedAt: now - 240000, workspace: web)
                tests.step = ThreadStep(tool: "Bash", target: "Run unit tests")
                expandedThreads = kind == "agents" ? [[], [checkout.id], [audit.id]][phase] : []
                displayThreads = kind == "workspaces" ? [first, second, third] : kind == "agents" ? [checkout, audit, tests] : [first, second]
                allThreads = displayThreads
                view.scrollOffset = 0; resizeToList(); step(); view.display()
                let bitmap = view.bitmapImageRepForCachingDisplay(in: view.bounds)!
                view.cacheDisplay(in: view.bounds, to: bitmap)
                let context = CGContext(data: nil, width: 720, height: 540, bitsPerComponent: 8, bytesPerRow: 0, space: CGColorSpaceCreateDeviceRGB(), bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue)!
                NSGraphicsContext.saveGraphicsState(); NSGraphicsContext.current = NSGraphicsContext(cgContext: context, flipped: false)
                NSColor(calibratedRed: 0.047, green: 0.062, blue: 0.082, alpha: 1).setFill(); NSRect(x: 0, y: 0, width: 720, height: 540).fill()
                let caption = kind == "pets" ? OriginalPets.catalog[phase].1 : kind == "status" ? ["Running", "Waiting for your reply", "Completed"][phase] : kind == "workspaces" ? ["All chats", "Grouped by workspace", "Click a group to collapse it"][phase] : kind == "agents" ? ["See what each chat is doing", "Open Agents to follow a workflow", "Every subagent: model, tokens, time"][phase] : ["Pet + chat panel", "Hide pet → keep the panel", "Bring the pet back anytime"][phase]
                let style = NSMutableParagraphStyle(); style.alignment = .center
                (caption as NSString).draw(in: NSRect(x: 20, y: 486, width: 680, height: 30), withAttributes: [.font: NSFont.systemFont(ofSize: 20, weight: .semibold), .foregroundColor: NSColor.white, .paragraphStyle: style])
                let scale = min(1.55, 630 / view.bounds.width, 410 / view.bounds.height)
                let rect = NSRect(x: (720 - view.bounds.width * scale) / 2, y: 46 + (410 - view.bounds.height * scale) / 2, width: view.bounds.width * scale, height: view.bounds.height * scale)
                context.draw(bitmap.cgImage!, in: rect)
                for i in 0..<3 { (phase == i ? NSColor.systemTeal : NSColor.white.withAlphaComponent(0.2)).setFill(); NSBezierPath(roundedRect: NSRect(x: 328 + i * 24, y: 26, width: 16, height: 3), xRadius: 1.5, yRadius: 1.5).fill() }
                NSGraphicsContext.restoreGraphicsState()
                let image = context.makeImage()!
                CGImageDestinationAddImage(gif, image, [kCGImagePropertyGIFDictionary: [kCGImagePropertyGIFDelayTime: 1.0/6, kCGImagePropertyGIFUnclampedDelayTime: 1.0/6]] as CFDictionary)
                if frame % 12 == 6 {
                    let png = CGImageDestinationCreateWithURL(folder.appendingPathComponent("\(kind)-\(phase).png") as CFURL, "public.png" as CFString, 1, nil)!
                    CGImageDestinationAddImage(png, image, nil); CGImageDestinationFinalize(png)
                }
                Thread.sleep(forTimeInterval: 1.0/6)
            }
            precondition(CGImageDestinationFinalize(gif))
            print("Rendered \(kind): 36 frames, 6 seconds")
        }
        NSApp.terminate(nil)
    }
